<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>

    <%- include('partials/header') %>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="hero-bg">
            <img src="/images/beehive-dental-1422002996-lq.jpg" alt="Beehive Dental Office">
        </div>
        <div class="hero-overlay">
            <div class="container">
                <p class="hero-subtitle">Premier Oakville Dentist</p>
                <h1 class="hero-title">Redefining your dental<br>care experience</h1>
                <div class="hero-buttons">
                    <a href="#book" class="btn-primary">BOOK ONLINE</a>
                    <a href="tel:9057885555" class="btn-secondary">Or Call (905) 788-5555</a>
                </div>
            </div>
        </div>
    </section>

    <!-- WELCOME SECTION -->
    <section class="welcome">
        <div class="container">
            <div class="welcome-content">
                <div class="welcome-text">
                    <h2>Welcome to Beehive Dental!</h2>
                    <p>Enjoy state-of-the-art dental care in a spa-like environment. Our experienced Oakville dentist, boasting two decades of dental experience, uses the latest technology and modern techniques to provide exceptional dentistry.</p>
                    <p>Inspired by the beehive's remarkable organization and creativity, our clinic mirrors this natural wonder, guiding us to deliver organized, efficient, and innovative dental care. Immerse yourself in a relaxing natural environment and transform your dental visit into a fun and enjoyable experience.</p>
                    <ul class="welcome-list">
                        <li>Serving the entire family - all ages welcome</li>
                        <li>Same-day emergency appointments are available</li>
                        <li>Transparent pricing (no surprise bills!)</li>
                    </ul>
                </div>
                <div class="welcome-image">
                    <img src="/images/beehive-1.jpg" alt="Beehive Dental Team">
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- STAR RATING -->
    <section class="rating-section">
        <div class="container">
            <div class="rating-stars">★★★★★</div>
        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials">
        <div class="container">
            <div class="hexagon-decoration">
                <img src="/images/hex02.png" alt="Hexagon">
            </div>
            <p class="testimonials-subtitle">Kind words from our patients</p>
            <p class="testimonials-note">Testimonials reflect individual experiences and may not represent all patients.</p>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <p>"Exceptional care and service at Beehive Dental! What sets this clinic apart is its attention to detail and personalized service. It's clear they genuinely care about making each visit as comfortable and stress-free as possible."</p>
                    <p class="author">— Ola M.</p>
                </div>
                <div class="testimonial-card">
                    <p>"Dr. Aly is amazing. He does such great work and has such great advice. He is not only super personable but is also so fast! We can't believe what he accomplished in an hour."</p>
                    <p class="author">— David S.</p>
                </div>
                <div class="testimonial-card">
                    <p>"I honestly have to say that Dr. Aly is the best dentist I've ever known. He has such a wonderful spirit and a smile that brightens the day."</p>
                    <p class="author">— Chelsea P.</p>
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
        <div class="container">
            <h2 class="section-title">All-in-one dental solutions, right here in one place</h2>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-image"><img src="/images/beehive-3.jpg" alt="Comprehensive Dentistry"></div>
                    <h3>Comprehensive Dentistry</h3>
                    <p>From routine cleanings to advanced surgeries, root canals, and full mouth rehabilitation, leverage our expertise and advanced technology to achieve exceptional results.</p>
                    <a href="#" class="service-link">MORE ABOUT COMPREHENSIVE DENTISTRY</a>
                </div>
                <div class="service-card">
                    <div class="service-image"><img src="/images/beehive-4.jpg" alt="Emergency Dentist"></div>
                    <h3>Emergency Dentist in Oakville</h3>
                    <p>In pain? Our Oakville emergency dentist offers immediate relief through same-day appointments and compassionate emergency care. Let's get you feeling better fast.</p>
                    <a href="#" class="service-link">MORE ABOUT EMERGENCY SERVICES</a>
                </div>
                <div class="service-card">
                    <div class="service-image"><img src="/images/beehive-2.jpg" alt="Orthodontics"></div>
                    <h3>Orthodontics in Oakville</h3>
                    <p>Modern and personalized orthodontic treatment for all ages. Interested in learning more? We invite you to book a complimentary orthodontic consultation.</p>
                    <a href="#" class="service-link">MORE ABOUT ORTHODONTIC SOLUTIONS</a>
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- LUXURY -->
    <section class="luxury">
        <div class="container">
            <div class="luxury-content">
                <div class="luxury-text">
                    <h2>A place of relaxation and rejuvenation</h2>
                    <h3>You deserve luxury!</h3>
                    <p>Our free signature comforts and perks:</p>
                    <ul>
                        <li>Free whitening for life</li>
                        <li>Ample free parking</li>
                        <li>Noise-cancellation headphones</li>
                        <li>Eye masks, cozy blankets, and supportive pillows</li>
                        <li>Aromatherapy with essential oils</li>
                        <li>Warm, lavender-scented towels</li>
                        <li>Kid-friendly amenities for our littlest patients</li>
                    </ul>
                    <a href="#" class="btn-secondary">YOUR FIRST VISIT</a>
                </div>
                <div class="luxury-image">
                    <img src="/images/beehive-4.jpg" alt="Dental Treatment Room">
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- PRICING & INSURANCE -->
    <section class="pricing-insurance">
        <div class="container">
            <div class="pricing-insurance-content">
                <div class="pricing-column">
                    <div class="icon-wrapper"><img src="/images/beehive-iso.png" alt="Icon" class="section-icon"></div>
                    <h3>Transparent Pricing</h3>
                    <h4>No Surprises</h4>
                    <p>Nothing is more important to us than delivering the highest quality of care — and that includes full transparency from start to finish. We keep you informed about the cost of any treatment so there are no surprises.</p>
                </div>
                <div class="insurance-column">
                    <div class="icon-wrapper"><img src="/images/beehive-iso.png" alt="Icon" class="section-icon"></div>
                    <h3>Insurance</h3>
                    <p>Beehive Dental offers direct billing to most insurance companies – this means we instantly know how much is covered, and can receive the payment directly on your behalf.</p>
                    <p>Give us a call at <a href="tel:9057885555">(905) 788-5555</a> with any questions. We're here to help.</p>
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- OFFICE TOUR -->
    <section class="office-tour">
        <div class="container">
            <div class="icon-wrapper-center">
                <img src="/images/beehive-iso.png" alt="Icon" class="section-icon">
            </div>
            <h2>Step Inside</h2>
            <p class="tour-subtitle">Take a tour of our state-of-the-art facility.</p>
            <div class="tour-grid">
                <div class="tour-image"><img src="/images/beehive-dental-tour0.jpg" alt="Office Tour 1"></div>
                <div class="tour-image"><img src="/images/beehive-dental-tour1-scaled.jpg" alt="Office Tour 2"></div>
                <div class="tour-image"><img src="/images/beehive-4.jpg" alt="Office Tour 3"></div>
            </div>
            <div class="clear"></div>
            <a href="#" class="btn-tour">TOUR THE OFFICE</a>
        </div>
    </section>

    <!-- VISIT -->
    <section class="visit-section">
        <div class="container">
            <div class="visit-content">
                <div class="hexagon-collage">
                    <img src="/images/beehive-dental-tour1-scaled.jpg" alt="Office Collage">
                </div>
                <div class="visit-info">
                    <h2>Visit Our Beehive</h2>
                    <p>Conveniently book online or give us a call at <strong>(905) 788-5555</strong>. Same-day appointments and ample free parking are available. We look forward to welcoming you!</p>
                    <div class="visit-details">
                        <div class="detail-item">
                            <img src="/images/beehive-iso.png" alt="Icon" class="detail-icon">
                            <div>
                                <p>1075 North Service Road West,<br>Suite 23<br>Oakville, Ontario</p>
                                <a href="#">Get Directions</a>
                            </div>
                        </div>
                        <div class="detail-item">
                            <img src="/images/beehive-iso.png" alt="Icon" class="detail-icon">
                            <div>
                                <p>Monday - Thursday - Saturday: 9-5<br>Tuesday - Wednesday - Friday: 9-7</p>
                            </div>
                        </div>
                        <div class="detail-item">
                            <img src="/images/beehive-iso.png" alt="Icon" class="detail-icon">
                            <div>
                                <p><a href="tel:9057885555">(905) 788-5555</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clear"></div>
        </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
        <div class="container">
            <img src="/images/beehive-iso.png" alt="Icon" class="cta-icon">
            <h2>Book today for quality care</h2>
            <p>Beehive Dental is committed to exceptional care with cutting-edge technology and an experienced team that prioritizes your well-being.</p>
            <a href="#" class="btn-primary">BOOK ONLINE</a>
        </div>
    </section>

    <%- include('partials/footer') %>

</body>
</html>