<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Beehive Dental Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
            <div class="admin-sidebar-header">
                <h3>Beehive Dental</h3>
                <p>Admin Panel</p>
            </div>
            <ul class="admin-nav">
                <li><a href="/admin/dashboard" class="<% if (active === 'dashboard') { %>active<% } %>">Dashboard</a></li>
                <li><a href="/admin/create" class="<% if (active === 'create') { %>active<% } %>">Add New Service</a></li>
                <li><a href="/services" target="_blank">View Site</a></li>
                <li><a href="/admin/logout" class="logout">Logout</a></li>
            </ul>
        </div>

        <!-- Main Content -->
        <div class="admin-main">
            <%- body %>
        </div>
    </div>
</body>
</html>